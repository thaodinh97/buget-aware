{
  "version": 2,
  "purpose": "Prospective test of service-aware queue planning and a hybrid digital twin",
  "seeds": [72042, 72043, 72044],
  "families": ["spread", "proportional"],
  "environments": ["none", "gradual_clients", "jitter_bandwidth"],
  "predictors": ["dt_queue", "rows_queue", "rows_legacy"],
  "alpha": 0.3,
  "margin_q": 0.9,
  "margin_window": 10,
  "expert_loss_alpha": 0.3,
  "expert_eta": 3.0,
  "expert_floor": 0.1,
  "requests": 12,
  "stream_seed_base": 82000,
  "shards": 4,
  "threads": 2,
  "train_config": "standard",
  "budget_scale": 0.75,
  "deadline_scale": 1.5,
  "mean_interarrival_scale": 0.2,
  "service_padding_seconds": 0.05,
  "stress_seed": 92000,
  "slow_factor_max": 4.0,
  "bandwidth_mbps_range": [5.0, 20.0],
  "noise_bucket_seconds": 1.0,
  "calibration_max_round_seconds": 60.0,
  "practical_targets": {
    "joint_success_gain_pp_vs_rows_legacy": 5.0,
    "environments_with_positive_gain": 2,
    "max_service_ratio_vs_rows_legacy": 1.1,
    "min_mean_paired_validation_f1_delta": -0.002,
    "min_block_validation_f1_delta": -0.005
  }
}
