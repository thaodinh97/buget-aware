{
  "method_context": "conpfu_inspired",
  "preprocessing_version": "toniot_connected_v3_auxfit_protocolfields",
  "seed": 42,
  "numeric_features": [
    "duration",
    "src_bytes",
    "dst_bytes",
    "missed_bytes",
    "src_pkts",
    "src_ip_bytes",
    "dst_pkts",
    "dst_ip_bytes",
    "http_request_body_len",
    "http_response_body_len"
  ],
  "categorical_features": [
    "proto",
    "service",
    "conn_state",
    "dns_qclass",
    "dns_qtype",
    "dns_rcode",
    "dns_AA",
    "dns_RD",
    "dns_RA",
    "dns_rejected",
    "http_method",
    "http_status_code",
    "http_trans_depth",
    "ssl_version",
    "ssl_resumed",
    "ssl_established",
    "weird_notice"
  ],
  "split_fractions": {
    "train": 0.6,
    "validation": 0.15,
    "calibration": 0.1,
    "test": 0.15
  },
  "duplicate_policy": "keep_first_exact_row_with_mapping",
  "conflict_policy": "retain_and_report",
  "group_policy": "connected_bidirectional_features",
  "transform_fit": "validation_only"
}
